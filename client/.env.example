# El proyecto YA incluye un TURN publico de respaldo (OpenRelay/Metered) para
# conectar tras NAT estricto, asi que normalmente no hace falta tocar nada.
#
# Si quieres usar tu propio TURN (recomendado en produccion), copia este archivo
# a client/.env y rellena las variables. Al definirlas, se omiten las de respaldo.
# Vite lee las variables VITE_* desde client/.env. Tras cambiarlo, hay que reconstruir.
VITE_TURN_URL=
VITE_TURN_USER=
VITE_TURN_CRED=
